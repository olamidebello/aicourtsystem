POSTGRES_DB=aicourt
POSTGRES_USER=aicourt
POSTGRES_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=aicourt
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET_EVIDENCE=evidence
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
OLLAMA_MODEL=llama3.2:3b
HTTP_PORT=80
HTTPS_PORT=443

# Set model IDs supported by your provider account; never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Install each named model in Ollama before selecting it.
OLLAMA_DRAFT_MODELS=llama3.2:3b

# Generated automatically by Ansible if absent. Never use example values.
ADMIN_SETUP_TOKEN=
NEWS_WORKER_TOKEN=
COOKIE_SECURE=true

# Required for public registration and password recovery (authenticated TLS SMTP).
PUBLIC_APP_URL=https://justisolve.com
ALLOW_REGISTRATION=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Generate once with: openssl rand -hex 32. Preserve this key across deployments.
# ansible/commerce.yml configures it automatically for existing deployments.
COMMERCE_ENCRYPTION_KEY=
